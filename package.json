{
  "name": "trading-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rule-based multi-strategy crypto trading bot on Cloudflare Workers",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev --env testnet",
    "deploy:testnet": "wrangler deploy --env testnet",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "engines": {
    "node": ">=20"
  }
}
